[Unit]
Description=BuildProof Surface runtime evidence relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/buildproof-surface.env
ExecStart=/usr/bin/python3 /opt/buildproof-surface/runtime_relay.py
Restart=always
RestartSec=3
User=buildproof-surface
Group=buildproof-surface
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buildproof-surface

[Install]
WantedBy=multi-user.target
