FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md PYPI_README.md ./
COPY buildproof ./buildproof
COPY codebase_rag ./codebase_rag
COPY cgr ./cgr
COPY codec ./codec

RUN pip install --no-cache-dir .

EXPOSE 8765

CMD ["buildproof", "--host", "0.0.0.0", "--port", "8765", "--repo", "/workspace/repo"]

